local activeKeys = {}

local function fireKey(keyCode, isPressed)
	pcall(function()
		VirtualInputManager:SendKeyEvent(isPressed, keyCode, false, game)
	end)
	pcall(function()
		ContextActionService:SetState(keyCode.Name, isPressed and Enum.UserInputState.Begin or Enum.UserInputState.End)
	end)
end

local function pressKey(keyCode)
	if activeKeys[keyCode] then return end
	activeKeys[keyCode] = true
	fireKey(keyCode, true)
end

local function releaseKey(keyCode)
	if not activeKeys[keyCode] then return end
	activeKeys[keyCode] = nil
	fireKey(keyCode, false)
end

local function rebuildKeyboard()
	local viewport = workspace.CurrentCamera.ViewportSize
	local maxWidth = math.min(viewport.X * 0.96, 950)

	local padding = 12
	local maxRowUnits = 0
	for _, row in ipairs(ROWS) do
		local total = 0
		for _, k in ipairs(row) do total += k[3] end
		maxRowUnits = math.max(maxRowUnits, total)
	end

	local widthAtBase = maxRowUnits * KEY_BASE + (maxRowUnits - 1) * KEY_GAP + padding
	local scale = math.min(1, maxWidth / widthAtBase)
	local keySize = math.max(20, math.floor(KEY_BASE * scale))
	local fontSize = math.clamp(math.floor(14 * scale), 8, 16)

	for _, child in ipairs(kbFrame:GetChildren()) do
		if child:IsA("Frame") and child.Name:match("^Row") then
			child:Destroy()
		end
	end

	for r, row in ipairs(ROWS) do
		local rowFrame = Instance.new("Frame")
		rowFrame.Name = "Row" .. r
		rowFrame.BackgroundTransparency = 1
		rowFrame.Size = UDim2.new(1, -padding, 0, keySize)
		rowFrame.LayoutOrder = r
		rowFrame.ZIndex = TOP_Z
		rowFrame.Parent = kbFrame

		local rl = Instance.new("UIListLayout")
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.Padding = UDim.new(0, KEY_GAP)
		rl.HorizontalAlignment = Enum.HorizontalAlignment.Center
		rl.SortOrder = Enum.SortOrder.LayoutOrder
		rl.Parent = rowFrame

		for i, keyData in ipairs(row) do
			local label, keyCode, units = keyData[1], keyData[2], keyData[3]

			local key = Instance.new("TextButton")
			key.Name = "Key_" .. label
			key.Size = UDim2.fromOffset(
				math.floor(keySize * units + (units - 1) * KEY_GAP),
				keySize
			)
			key.BackgroundColor3 = KEY_COLOR
			key.BorderSizePixel = 0
			key.Text = label
			key.TextColor3 = TEXT_COLOR
			key.Font = Enum.Font.Gotham
			key.TextSize = fontSize
			key.AutoButtonColor = false
			key.LayoutOrder = i
			key.ZIndex = TOP_Z
			key.Parent = rowFrame

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 5)
			corner.Parent = key

			local isDown = false
			local function doPress()
				if isDown then return end
				isDown = true
				key.BackgroundColor3 = KEY_PRESSED
				key.TextColor3 = PRESSED_TEXT
				pressKey(keyCode)
			end
			local function doRelease()
				if not isDown then return end
				isDown = false
				key.BackgroundColor3 = KEY_COLOR
				key.TextColor3 = TEXT_COLOR
				releaseKey(keyCode)
			end

			key.MouseButton1Down:Connect(doPress)
			key.MouseButton1Up:Connect(doRelease)
			key.MouseLeave:Connect(doRelease)
		end
	end

	kbFrame.Size = UDim2.new(
		0,
		maxRowUnits * keySize + (maxRowUnits - 1) * KEY_GAP + padding,
		0,
		#ROWS * keySize + (#ROWS - 1) * KEY_GAP + padding
	)
end

local isOpen = false
local function setOpen(v)
	isOpen = v
	kbFrame.Visible = v
	toggleStroke.Thickness = v and 2 or 0
	toggleBtn.BackgroundColor3 = v and TOGGLE_ON or TOGGLE_OFF
end

toggleBtn.MouseButton1Click:Connect(function()
	setOpen(not isOpen)
end)

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	rebuildKeyboard()
end)

rebuildKeyboard()
setOpen(false)
